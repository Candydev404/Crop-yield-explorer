# Copy to .streamlit/secrets.toml for local runs, or paste into Streamlit Community Cloud > App > Settings > Secrets.
# NEVER commit the real secrets.toml. Use the ANON (public) key only. Never put the service_role key here.
[supabase]
url = "https://YOUR-PROJECT-REF.supabase.co"
anon_key = "YOUR-SUPABASE-ANON-PUBLIC-KEY"
app_url = "https://YOUR-APP.streamlit.app"      # no trailing slash; http://localhost:8501 for local runs
google_enabled = false                           # set true only after Google is enabled in Supabase
